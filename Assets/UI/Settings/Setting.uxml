<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="CustomSlider" src="project://database/Assets/UI/Custom/CustomSlider.uxml?fileID=9197481963319205126&amp;guid=8d2041e3dd2857442949e3abc719e670&amp;type=3#CustomSlider" />
    <ui:VisualElement name="RootVisualElement" style="top: 50%; translate: 0 -50%; width: 1200px; height: 680px; align-self: center; background-color: rgba(255, 255, 255, 0); -unity-font-definition: initial; -unity-font: url(&quot;project://database/Assets/Art/Fonts/Maplestory%20OTF%20Light.otf?fileID=12800000&amp;guid=c898bc1e681edb94cadfa44f910b0511&amp;type=3#Maplestory OTF Light&quot;); font-size: 40px; -unity-text-align: middle-center;">
        <ui:VisualElement name="MenuButtonContainer" style="flex-grow: 0; width: 280px; height: 80px; flex-direction: row; justify-content: space-between;">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 80px; height: 80px;" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 80px; height: 80px;" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 80px; height: 80px;" />
        </ui:VisualElement>
        <ui:VisualElement name="SoundContainer" style="flex-grow: 0; background-color: rgb(255, 169, 169); position: relative; width: 1200px; height: 440px; left: auto; top: 0; right: auto; display: none;">
            <ui:VisualElement name="SlidersContainer" style="flex-grow: 0; top: 60px; left: 0; justify-content: space-between; width: 1120px; height: 380px; align-items: center; align-self: auto;">
                <ui:Instance template="CustomSlider" name="MasterSlider" />
                <ui:Instance template="CustomSlider" name="BGMSlider" />
                <ui:Instance template="CustomSlider" name="SFXSlider" />
                <ui:Instance template="CustomSlider" name="VoiceSlider" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="DisplayContainer" style="flex-grow: 0; background-color: rgb(255, 169, 169); position: relative; width: 1200px; height: 440px; display: flex; top: 0; align-self: auto;">
            <ui:VisualElement name="DropDownContainer" style="flex-grow: 0; height: 284px; align-items: center; flex-direction: row; width: 1200px; align-self: auto; justify-content: center;">
                <ui:DropdownField label="Dropdown" name="DropdownField" style="justify-content: flex-start; align-items: stretch; width: 1000px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 100px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; height: 50px; margin-left: 100px; margin-right: 200px; flex-direction: row; justify-content: space-around;">
                <ui:Label tabindex="-1" text="화면 모드" parse-escape-sequences="true" display-tooltip-when-elided="true" />
                <ui:Toggle label="전체 화면" />
                <ui:Toggle label="창 화면" />
                <ui:Toggle label="테두리 없음" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="EtcContainer" style="flex-grow: 0; background-color: rgb(255, 169, 169); position: relative; width: 1200px; height: 440px; opacity: 1; display: none; top: 0;" />
        <ui:VisualElement name="ButtonContainer" style="flex-grow: 0; height: 140px; -unity-background-image-tint-color: rgb(0, 0, 0); flex-direction: row; background-color: rgb(255, 124, 124); justify-content: space-between;">
            <ui:VisualElement name="LeftsideButtonContainer" style="flex-grow: 0; flex-direction: row; justify-content: center; align-items: center; width: 410px;">
                <ui:Button text="설정 초기화" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 300px; height: 80px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="RightsideButtonContainer" style="flex-grow: 0; flex-direction: row; width: 430px; justify-content: space-between; align-self: auto; align-items: center; margin-right: 55px;">
                <ui:Button text="저장" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 200px; height: 80px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Button text="닫기" parse-escape-sequences="true" display-tooltip-when-elided="true" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 200px; height: 80px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
