                            <ui:Label tabindex="-1" text="이름이 들어가는 공간입니다" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ItemNameLabel" style="background-image: url(&quot;project://database/Assets/Art/Sprites/01.UI/UI_Tile01.png?fileID=21300000&amp;guid=f71c8f459a18ed645bdc23972e6728f9&amp;type=3#UI_Tile01&quot;); -unity-background-scale-mode: scale-and-crop; height: 50px; -unity-font-definition: initial; flex-shrink: 1; flex-grow: 1; width: 500px; margin-top: 20px;" />
                            <ui:VisualElement style="flex-grow: 0; height: 138px; width: 500px; flex-direction: row; align-items: center; justify-content: space-between;">
