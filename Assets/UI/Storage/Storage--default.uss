.





#InventoryContainer {
    width: 820px;
    height: 460px;
    background-color: rgba(255, 23, 23, 0.49);
    left: 126px;
    top: 300px;
    justify-content: space-between;
}

.slot-array {
    flex-direction: row;
    justify-content: center;
    height: 80px;
    width: auto;
}

.slot-button {
    width: 80px;
    height: 80px;
    margin: 0;
    padding: 0;
    flex-shrink: 1;
    flex-grow: 1;
}

.nav-arrow-button {
    width: 50px;
    height: 50px;
    border-width: 0;
    margin: 0;
}

#StorageContainerLeft > #ExpansionOrganizeButton {
    display: flex;
}

.Storage--Default {
    display: flex;
    align-items: center;
    height: 100%;
    width: 50%;
    justify-content: center;
}

.InventoryMode
{
    visibility: visible;

}
.StorageMode{
    visibility: hidden;
}

.Storage--ExpansionOrganize.InventoryMode {
    visibility: hidden;

} .StorageMode{
    visibility: visible;
}
