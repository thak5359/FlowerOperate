<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/ItemShop/ItemShopUI.uss?fileID=7433441132597879392&amp;guid=5d6420fa3ba28c841afdfdc3879eee74&amp;type=3#ItemShopUI" />
    <ui:VisualElement name="rootVisualElement" class="shop-root" style="flex-grow: 0; -unity-font: url(&quot;project://database/Assets/Art/Fonts/Maplestory%20OTF%20Bold.otf?fileID=12800000&amp;guid=7f4a2fed048061b479a84b7e1d64a862&amp;type=3#Maplestory OTF Bold&quot;); -unity-font-definition: initial;">
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="CloseButton" class="shop-close-button" />
        <ui:VisualElement name="ItemShopContainer" class="shop-container">
            <ui:ScrollView name="ScrollView" class="shop-scroll-view" />
            <ui:VisualElement name="DescriptionView" class="shop-description-view">
                <ui:VisualElement name="HeaderDataContainer" class="shop-header-container">
                    <ui:VisualElement name="ImageIconFrame" class="shop-icon-frame" style="background-image: url(&quot;project://database/Assets/Art/Sprites/01.UI/UI_Tile03_1.png?fileID=21300000&amp;guid=d66e0a95be1ddf544a98b2f706703a57&amp;type=3#UI_Tile03_1&quot;);">
                        <ui:VisualElement name="ImageIcon" class="shop-icon-image" style="background-image: none;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="DetailDataContainer" class="shop-detail-container" />
                <ui:VisualElement name="ButtonContainer" class="shop-button-container">
                    <ui:Button text="구입" parse-escape-sequences="true" display-tooltip-when-elided="true" name="BuyButton" class="shop-buy-button" style="-unity-background-scale-mode: stretch-to-fill; background-image: url(&quot;project://database/Assets/Art/Sprites/01.UI/SamplePSD/A20.png?fileID=21300000&amp;guid=243b278ced3b32b4f9937d8cfc0c364d&amp;type=3#A20&quot;); -unity-font-definition: initial;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
