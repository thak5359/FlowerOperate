                                    <ui:VisualElement name="IteItemIcon" style="flex-grow: 0; width: 80px; height: 80px; background-image: url(&quot;project://database/Assets/Art/Sprites/01.UI/UI_Tile03_1.png?fileID=21300000&amp;guid=d66e0a95be1ddf544a98b2f706703a57&amp;type=3#UI_Tile03_1&quot;);" />
