        <ui:VisualElement name="VisualElement" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Art/Sprites/01.UI/UI_Tile01.png?fileID=21300000&amp;guid=f71c8f459a18ed645bdc23972e6728f9&amp;type=3#UI_Tile01&quot;); align-items: center; justify-content: center; padding-top: 11px; padding-right: 16px; padding-bottom: 11px; padding-left: 16px; height: 150px;">
            <ui:Label tabindex="-1" text="내게는 고통밖에 없습니다.&#10;그것 말고는 아무것도 바라지 않습니다.&#10;고통은 내게 충실했고 그것은 지금도 변함이 없습니다.&#10;내 영혼이 심연의 바닥을 헤멜때에도&#10;고통은 늘 곁에 앉아 나를 지켜주었으니&#10;어떻게 고통을 원망하겠습니까." parse-escape-sequences="true" display-tooltip-when-elided="true" name="FlavorTextLabel" style="flex-shrink: 0; white-space: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; height: 100%; -unity-text-align: upper-left; width: 100%; font-size: 12px;" />
