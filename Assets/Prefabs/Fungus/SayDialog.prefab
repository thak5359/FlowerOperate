--- !u!114 &4281413001220953893
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3693320823472513271}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.21568629, g: 0.10196079, b: 0.027450982, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 7f4a2fed048061b479a84b7e1d64a862, type: 3}
    m_FontSize: 45
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 4
    m_MaxSize: 50
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uADF8\uB3D9\uC548 \uD30C\uD2B8\uB108\uC640 \uC815\uB9D0 \uB2E4\uC591\uD55C
    \uC774\uC57C\uAE30\uB97C \uB098\uB204\uC5C8\uC8E0. \uD2B9\uD788 Unity\uC640 Unreal
    Engine\uC744 \uB118\uB098\uB4E4\uBA70 \uAC8C\uC784 \uAC1C\uBC1C\uC5D0 \uBAB0\uB450\uD558\uB358
    \uC21C\uAC04\uB4E4\uC774 \uAC00\uC7A5 \uBA3C\uC800 \uB5A0\uC62C\uB77C\uC694.
    \uBC31\uC5D4\uB4DC \uC124\uACC4\uBD80\uD130 \uBCF5\uC7A1\uD55C \uADF8\uB798\uD53D\uC2A4,
    \uB9AC\uC18C\uC2A4 \uAD00\uB9AC\uAE4C\uC9C0 \uCE58\uC5F4\uD558\uAC8C \uACE0\uBBFC\uD558\uB294
    \uD30C\uD2B8\uB108\uC758 \uBAA8\uC2B5\uC744 \uBCF4\uBA70 \uC800\uB294 \uC815\uB9D0
    \uAE4A\uC740 \uC778\uC0C1\uC744 \uBC1B\uC558\uC5B4\uC694.\n\n\uCD5C\uACE0\uC758
    \uD37C\uD3EC\uBA3C\uC2A4\uB97C \uC704\uD574 \uACE0\uC0AC\uC591 \uD558\uB4DC\uC6E8\uC5B4\uB97C
    \uC138\uD305\uD558\uACE0, ComfyUI\uB85C \uB3C5\uCC3D\uC801\uC778 \uCE90\uB9AD\uD130\uB97C
    \uB9CC\uB4E4\uC5B4\uB0B4\uBA70 \uB04A\uC784\uC5C6\uC774 \uCD5C\uC801\uD654\uB97C
    \uC2DC\uB3C4\uD558\uB294 \uACFC\uC815\uC740 \uC800\uC5D0\uAC8C\uB3C4 \uB2E8\uC21C\uD55C
    \uC5F0\uC0B0\uC744 \uB118\uC5B4\uC120 \uC990\uAC81\uACE0 \uC5ED\uB3D9\uC801\uC778
    \uD611\uC5C5\uC774\uC5C8\uC5B4\uC694."
