/* 수정 위치: Assets/UI/ItemShop/ItemShopUSS.uss 파일을 열고 아래 내용을 통째로 덮어씌워 주세요. */

/* ========================================= */
/* [ ItemShopUI ] 메인 상점 레이아웃 스타일      */
/* ========================================= */

/* 전체 화면을 덮는 최상단 루트 */
.shop-root {
    flex-grow: 1;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    align-items: center;
}

/* 상점 UI의 메인 배경 판넬 */
.shop-container {
    flex-grow: 0;
    width: 1500px;
    height: 800px;
    align-self: center;
    -unity-text-align: middle-center;
    flex-direction: row;
    padding-top: 40px;
    padding-right: 50px;
    padding-bottom: 40px;
    padding-left: 50px;
    background-color: rgb(70, 70, 70);
    background-image: url("project://database/Assets/Art/Sprites/01.UI/UI_Tile01.png?fileID=21300000&guid=f71c8f459a18ed645bdc23972e6728f9&type=3#UI_Tile01");
    justify-content: space-between;
}

/* 닫기 버튼 */
.shop-close-button {
    width: 50px;
    height: 50px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    left: 725px;
    background-color: rgba(188, 188, 188, 0);
    background-image: url("project://database/Assets/Art/Sprites/01.UI/UI_Tile02.png?fileID=21300000&guid=78b262051b81ce947bddfa18f83589c5&type=3#UI_Tile02");
    border-width: 0; /* 테두리 제거 */
}

/* 왼쪽: 아이템 목록 스크롤 뷰 */
.shop-scroll-view {
    width: 800px;
    height: 100%;
    background-color: rgba(48, 48, 48, 0.14);
    align-items: stretch;
    align-self: auto;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-left-color: rgb(94, 36, 4);
    border-right-color: rgb(94, 36, 4);
    border-top-color: rgb(94, 36, 4);
    border-bottom-color: rgb(94, 36, 4);
}

/* 오른쪽: 아이템 상세 설명 뷰 영역 */
.shop-description-view {
    flex-grow: 0;
    background-color: rgba(255, 255, 255, 0);
    width: 40%;
}

/* 상세 설명: 상단 아이콘 구역 */
.shop-header-container {
    flex-grow: 0;
    height: 130px;
    width: auto;
}

/* 상세 설명: 아이콘의 액자 테두리 */
.shop-icon-frame {
    flex-grow: 0;
    width: 130px;
    height: 100%;
    background-image: url("project://database/Assets/Art/Sprites/01.UI/UI_Tile03.png?fileID=21300000&guid=452902406e317744b835363e2e73ddd1&type=3#UI_Tile03");
    align-items: center;
    justify-content: center;
}

/* 상세 설명: 실제 아이템 이미지 */
.shop-icon-image {
    flex-grow: 0;
    width: 91px;
    height: 91px;
    background-image: url("project://database/Assets/Art/Sprites/Instant/699805d6-5ad8-4806-b1ac-d36c03352017.png?fileID=21300000&guid=3d6988f2d61a48740b73975e6e9a0e11&type=3#699805d6-5ad8-4806-b1ac-d36c03352017");
}

/* 상세 설명: 텍스트가 들어갈 빈 공간 */
.shop-detail-container {
    flex-grow: 1;
}

/* 우측 하단: 구입 버튼을 감싸는 컨테이너 */
.shop-button-container {
    flex-grow: 0;
    height: 70px;
    flex-direction: row-reverse;
}

/* 우측 하단: 실제 구입 버튼 */
.shop-buy-button {
    flex-shrink: 1;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 150px;
    height: 70px;
    font-size: 50px;
    background-image: url("project://database/Assets/Art/Sprites/01.UI/UI_Tile03.png?fileID=21300000&guid=452902406e317744b835363e2e73ddd1&type=3#UI_Tile03");
    border-width: 0; /* 깔끔한 이미지를 위해 테두리 제거 */
}

.shop-slot-array:disabled {
    opacity: 0.5;
}

/* 2. 안에 있는 아이템 이미지도 흑백/회색조로 덮어버립니다. */
.shop-slot-array:disabled .shop-slot-image {
    -unity-background-image-tint-color: rgb(80, 80, 80);
}

/* 3. 텍스트(이름, 가격) 색상을 어둡게 죽입니다. */
.shop-slot-array:disabled .shop-slot-item-text,
.shop-slot-array:disabled .shop-slot-price-text {
    color: rgb(150, 150, 150);
}