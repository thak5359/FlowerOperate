                                    <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="PriceLabel" style="min-width: 150px; min-height: 30px; background-image: url(&quot;project://database/Assets/Art/Sprites/01.UI/SamplePSD/A08.png?fileID=21300000&amp;guid=9f78ce6292a9aee40a13df5d0c2a8429&amp;type=3#A08&quot;); -unity-background-scale-mode: stretch-to-fill; width: 150px; height: 30px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
